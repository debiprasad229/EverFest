# EverFest Frontend Environment Variables
# -------------------------------------------------------------
# Local Development (using Vite proxy to port 5000):
# Leave empty to automatically use the Vite proxy (/api)
# VITE_API_URL=http://localhost:5000/api/v1
#
# Production (e.g. deployed on Vercel connecting to Render/Railway):
# Set this in your Vercel Project Settings > Environment Variables:
# VITE_API_URL=https://your-everfest-backend.onrender.com/api/v1
# -------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api/v1
