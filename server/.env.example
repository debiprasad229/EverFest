# EverFest Backend Environment Variables
# -------------------------------------------------------------
# Server Network Settings
PORT=5000
NODE_ENV=production

# CORS Configuration (Production Frontend Origins)
# Set this to your live Vercel domain. Multiple domains can be comma-separated:
# Example: CLIENT_URL=https://everfest.vercel.app,https://everfest-staging.vercel.app
CLIENT_URL=http://localhost:5173

# Google Gemini AI Integration (Backend-Only)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# NEVER expose this key to frontend code or client environment variables.
# If omitted or invalid, EverFest seamlessly falls back to its deterministic domain planning engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
